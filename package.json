{
  "name": "ds-whale-shooter-pc",
  "description": "DS Whale Shooter — a top-down, anime-styled pixel art shooter built on Phaser 4 + React + Vite + TypeScript.",
  "version": "1.7.3",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zzu20137670613/ds-whale-shooter-PC.git"
  },
  "author": "Yongzhuo Liang <firetable@foxmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://gitee.com/zzu20137670613/ds-whale-shooter-PC/issues"
  },
  "homepage": "https://gitee.com/zzu20137670613/ds-whale-shooter-PC#readme",
  "keywords": [
    "phaser",
    "phaser4",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "serve": "node log.js serve & vite preview --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "serve-nolog": "vite preview --config vite/config.prod.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "dist": "vite build --config vite/config.prod.mjs",
    "pack:win": "node scripts/pack-win.mjs",
    "shots": "node scripts/shots.mjs",
    "pack:installer": "node scripts/pack-installer.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "earcut": "^3.2.3",
    "easystarjs": "^0.4.4",
    "konva": "^10.3.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.27.0",
    "phaser": "4.0.0",
    "poly-decomp": "^0.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "colord": "^2.9.3",
    "dotenv": "^17.4.2",
    "electron": "^33.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "image-q": "^4.0.0",
    "js-yaml": "^5.2.2",
    "lint-staged": "^15.2.10",
    "openai": "^6.49.0",
    "pngjs": "7.0.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^23.0.0",
    "resedit": "^2.0.0",
    "terser": "^5.28.1",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^2.1.0"
  },
  "main": "electron/main.cjs"
}
