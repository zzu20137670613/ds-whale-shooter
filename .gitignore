/tmp/
.playground

# Claude working notes (plans, scratch)
.claude
# Public backup (created before editor changes for safe rollback)
public-bk/

grok
.grok
# AI source sheets (assets/**/raws/) - the game loads the PROCESSED
# sprites, not these. They are source material, not runtime assets, and
# make up ~73 of the ~110 MB in public/. Excluded on the owner's call.
raws/

# Byte-cache from the python tools under scripts/
__pycache__/
*.pyc


# assembled world plates are derived from blocks/ and too large for git
art-source/*/world/

# The owner's own reference material (comics, mood boards) stays local â€” 15 MB+
# of pages per level, and he keeps the originals. The design they produced is
# written down in art-source/<level>/LEVEL-DESIGN.md instead.
art-source/*/reference/
art-source/*/_sheet/
# Office/WPS lock files (~$name.ext) created when a doc is opened
~\$*