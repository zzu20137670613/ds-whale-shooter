# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files: keep .env.example tracked, ignore the rest
.env
.env.*
!.env.example

# Local scratch / AI gen outputs (image, music, �?
/tmp/
.playground

# Claude working notes (plans, scratch)
.claude
# Public backup (created before editor changes for safe rollback)
public-bk/

grok
.grok
# AI source sheets (assets/**/raws/) - the game loads the PROCESSED
# sprites, not these. They are source material, not runtime assets, and
# make up ~73 of the ~110 MB in public/. Excluded on the owner's call.
raws/

# Byte-cache from the python tools under scripts/
__pycache__/
*.pyc


# assembled world plates are derived from blocks/ and too large for git
art-source/*/world/

# The owner's own reference material (comics, mood boards) stays local — 15 MB+
# of pages per level, and he keeps the originals. The design they produced is
# written down in art-source/<level>/LEVEL-DESIGN.md instead.
art-source/*/reference/
art-source/*/_sheet/
# Office/WPS lock files (~$name.ext) created when a doc is opened
~\$*


# 源素材不进仓库：art-source/ 是作画工作材料（1.1 GB），其中 8 个 png 单独超过
# Gitee 的 50 MB 上限。仓库里只留可读的设计说明与提示词。
art-source/**
!art-source/**/
!art-source/**/*.md
!art-source/**/*.txt

# Packaged desktop build (electron) - regenerated by pnpm pack, never committed.
release/


# NSIS scratch dir (makensis needs a TMP it can mmap)
.tmp-nsis/


# Tool caches (NSIS etc.) - never commit
.cache/
